    "monaco-editor": "^0.50.0",
    "recharts": "^2.10.3",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.1",
    "i18next": "^23.7.6",
    "react-i18next": "^13.5.0",
    "clsx": "^2.0.0",
    "dompurify": "^3.0.6"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/node": "^20.10.5",
