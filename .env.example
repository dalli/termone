# Database Configuration
DATABASE_URL=postgresql+asyncpg://termone_user:termone_password@postgres:5432/termone_db
# For local development: DATABASE_URL=postgresql+asyncpg://localhost/termone_db

# Encryption & Security
ENCRYPTION_MASTER_KEY=your-64-character-base64-encoded-key-here-minimum-32-bytes
JWT_SECRET=your-very-long-jwt-secret-key-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1
REFRESH_TOKEN_EXPIRATION_DAYS=30

# TOTP Configuration
TOTP_ISSUER=Termone

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_LOG_LEVEL=INFO

# Frontend Configuration
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_API_CALLS_PER_MINUTE=100

# SSH Configuration
SSH_CONNECTION_TIMEOUT_SECONDS=30
SSH_COMMAND_TIMEOUT_SECONDS=300
SSH_MAX_CONCURRENT_SESSIONS=50
SSH_KEY_PATH=/home/termone/.ssh/id_rsa
SSH_KNOWN_HOSTS_PATH=/home/termone/.ssh/known_hosts

# Terminal Session Configuration
TERMINAL_SESSION_TIMEOUT_MINUTES=30
TERMINAL_IDLE_TIMEOUT_MINUTES=5
TERMINAL_HEARTBEAT_INTERVAL_SECONDS=30

# File Transfer Configuration
FILE_UPLOAD_MAX_SIZE_MB=100
FILE_DOWNLOAD_CHUNK_SIZE_KB=256
SFTP_TIMEOUT_SECONDS=30

# WebSocket Configuration
WEBSOCKET_PING_INTERVAL_SECONDS=30
WEBSOCKET_RECONNECT_TIMEOUT_SECONDS=30
WEBSOCKET_BUFFER_SIZE_MB=10

# OIDC / SSO Configuration (optional, can be configured via admin panel)
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
OIDC_SCOPES=openid,profile,email

# Audit Logging
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_LOG_LEVEL=INFO

# Development Settings
DEBUG=false
TESTING=false
ALLOW_REGISTRATION=true

# Redis/Cache (optional)
REDIS_URL=redis://redis:6379/0

# Email Configuration (optional, for notifications)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@termone.local

# Nginx Configuration (for reverse proxy)
NGINX_BACKEND_HOST=backend
NGINX_BACKEND_PORT=8000
NGINX_FRONTEND_PORT=5173

# Logging
LOG_FORMAT=json
LOG_OUTPUT=stdout
